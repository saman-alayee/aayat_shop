# Server
PORT=3001
NODE_ENV=development

# Database — SQLite for local dev (no MySQL install):
DATABASE_URL="file:./dev.db"
# Production (MySQL/MariaDB):
# DATABASE_URL="mysql://USER:PASSWORD@localhost:3306/DATABASE_NAME"

# Redis (optional for local — disable if Redis is not installed)
REDIS_URL="redis://localhost:6379"
REDIS_DISABLED=true

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=7d

# OTP — keep false in production so real SMS is sent and no code is returned to the client
OTP_EXPIRES_MINUTES=5
OTP_DEV_MODE=false

# Order SMS from the old shop: Melli Payamak pattern (service line). Leave SMS_PROVIDER=farazsms to keep Faraz.
SMS_PROVIDER=farazsms
MELIPAYAMAK_USERNAME=
MELIPAYAMAK_PASSWORD=
# When the panel returns -110, put the API key here. It is sent in the password field.
MELIPAYAMAK_API_KEY=
MELIPAYAMAK_SENDER=
MELIPAYAMAK_CUSTOMER_BODY_ID=
MELIPAYAMAK_ADMIN_BODY_ID=
MELIPAYAMAK_OTP_BODY_ID=
MELIPAYAMAK_ADMIN_PHONES=

# Zibal. Shop prices are toman; the request amount is toman × 10 (rial).
ZIBAL_MERCHANT=
FRONTEND_URL=http://127.0.0.1:3000
API_PUBLIC_URL=http://127.0.0.1:3001
# ZIBAL_CALLBACK_URL=http://127.0.0.1:3001/api/payments/zibal/callback

# FarazSMS / Iran Payamak (pattern SMS for OTP)
# Get Api-Key and pattern code from FarazSMS panel — do NOT use Login token
FARAZSMS_API_KEY=
FARAZSMS_PATTERN_CODE=
FARAZSMS_LINE_NUMBER=90008361
FARAZSMS_NUMBER_FORMAT=english
# Variable name in your pattern template (must match panel exactly)
FARAZSMS_OTP_ATTRIBUTE=code

# Upload
UPLOAD_DIR=uploads
MAX_FILE_SIZE=5242880

# CORS
CORS_ORIGIN=http://localhost:3000

# Admin seed (comma-separated extra admins via ADMIN_PHONES)
ADMIN_PHONE=09120000000
ADMIN_PHONES=09051770091
ADMIN_PASSWORD=admin1234
